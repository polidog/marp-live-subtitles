{
  "name": "marp-live-subtitles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:site": "pnpm build:embed && mkdir -p site && cp dist/live-subtitles.js site/",
    "deploy": "pnpm build:site && pnpm dlx wrangler deploy",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.8.3",
    "vite": "8.3.0",
    "wxt": "^0.20.0"
  }
}
